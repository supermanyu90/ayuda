# ---- Server ----
PORT=8787
NODE_ENV=development
# Comma-separated list of allowed browser origins (exact match).
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://ayuda:ayuda_local@localhost:5433/ayuda
# Set to "true" on managed Postgres that requires TLS (Render).
DATABASE_SSL=false

# ---- Gemma 3 4B (open-weight) ----
# ollama   -> native Ollama API (local, default)
# openai   -> any OpenAI-compatible server hosting Gemma 3 4B (vLLM, llama.cpp, Ollama /v1, hosted)
# off      -> no model; deterministic fallback parser only (clearly labelled in the UI)
GEMMA_PROVIDER=ollama
GEMMA_BASE_URL=http://localhost:11434
GEMMA_MODEL=gemma3:4b
GEMMA_API_KEY=
GEMMA_TIMEOUT_MS=45000

# ---- ElevenLabs (server-side only, never exposed to the browser) ----
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Any voice ID available to your ElevenLabs account (Voice Library -> ID)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvAqDcQVLR

# ---- Geocoding (OpenStreetMap Nominatim; follow its usage policy) ----
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Identify your deployment; Nominatim rejects placeholder/example contacts.
GEOCODER_USER_AGENT=Ayuda/0.1 (volunteering app)
# Restrict manual location search to these ISO country codes (empty = worldwide).
GEOCODER_COUNTRY_CODES=in

# ---- Admin ----
# Long random string. Required for organisation/verification endpoints.
ADMIN_TOKEN=
